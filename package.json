    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
